# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Ваш Telegram ID (узнать: @userinfobot). Несколько админов — через запятую
ADMIN_ID=123456789

# Куда слать заявки и вопросы. ID группы менеджеров (начинается с -100...)
# или личный ID менеджера. Пусто — шлём первому админу (пример группы: -1001234567890)
MANAGER_CHAT_ID=

# Необязательно: Redis для FSM (состояния не теряются при перезапуске)
# REDIS_URL=redis://localhost:6379/0

# Необязательно
# DB_PATH=data/bot.db
# LOG_LEVEL=INFO
# ANTIFLOOD_LIMIT=5
# ANTIFLOOD_PERIOD=10
# CALLBACK_LIMIT=12

# Если сервер в РФ не достаёт до api.telegram.org — один из вариантов:
# TELEGRAM_PROXY=socks5://user:password@1.2.3.4:1080
# TELEGRAM_API_URL=https://your-mirror.example.com
